# Vorlage fuer die Variablen des Stacks. In Portainer beim Stack unter "Environment variables" eintragen oder mit
# "Load variables from .env file" laden; mit Docker Compose als Datei .env neben der Compose-Datei (nie einchecken).
# Den ersten Administrator, die oeffentliche Adresse und das Branding legt die Ersteinrichtung im Browser fest, ab der ersten Version
# mit eingebautem Schluessel des Lizenzgebers auch den Lizenzschluessel.

# Pflicht: Kennwort der Datenbank (nur intern zwischen den Containern). Lang und zufaellig waehlen, etwa mit: openssl rand -hex 32
# Nach dem ersten Start nicht mehr aendern, sonst findet der Server die Datenbank nicht.
POSTGRES_PASSWORD=BITTE-AENDERN-langes-zufallspasswort

# Version des Server-Images (Standard latest). Fester Stand: die Version eintragen, die der Lizenzgeber nennt, etwa 0.87.0.
# RMM_IMAGE_TAG=latest

# Externer HTTP-Port des Servers (nur docker-compose.yml; davor gehoert ein Reverse-Proxy mit TLS)
RMM_HTTP_PORT=8080

# Notfallweg, wenn der einzige Administrator ausgesperrt ist (leer = aus): seine E-Mail eintragen und den Stack neu
# bereitstellen; das neue Startkennwort steht einmal im Container-Log. Danach wieder leeren.
RMM_RECOVER_ADMIN=

# Vorgabe fuer den Produktnamen, solange die Ersteinrichtung bzw. die Oberflaeche keinen setzt (leer = Vorgabe des Servers)
RMM_PRODUCT_NAME=

# Agents automatisch auf den Stand des Server-Builds aktualisieren (Vorgabe; die Einstellung in der Oberflaeche gewinnt)
RMM_AGENT_AUTOUPDATE=true

# Optionaler Rueckfall fuer eine unbeaufsichtigte Installation: der Lizenzschluessel vom Lizenzgeber als eine Zeile. Der Server
# wertet ihn ab der ersten Version mit eingebautem Schluessel des Lizenzgebers aus. Im Normalfall leer lassen und den Schluessel
# in der Ersteinrichtung eintragen.
RMM_LICENSE=

# --- Testwerkzeuge (leer = aus) ---
# true zeigt in den Aktionen eines Geraets "Neustart-Abfrage testen" und "Automatik-Lauf jetzt starten". Im Alltag aus lassen.
RMM_DEV_TOOLS=

# --- Vertrauenswuerdige Reverse-Proxys, nur im Notfall (leer = Einstellung der Oberflaeche) ---
# Ab Werk uebernimmt der Server X-Forwarded-For und X-Forwarded-Proto nur von Loopback und privaten Netzen; aendern unter
# Einstellungen, Server & Verbindung, Reverse-Proxy. Gesetzt gewinnt diese Variable: eine Netzliste (z. B. 172.20.0.0/16),
# any (jeder Absender, Adressen und https faelschbar) oder none (keiner).
# RMM_TRUSTED_PROXIES=

# --- Proxy fuer ausgehende Verbindungen des Servers, etwa zur Lizenz-Instanz und fuer Web-Push (leer = direkt) ---
# HTTPS_PROXY=http://proxy.example.de:3128
# NO_PROXY=localhost,db

# --- Datenpfade (leer = benannte Docker-Datentraeger) ---
# RMM_DB_PATH=/srv/rmm/db
# RMM_KEYS_PATH=/srv/rmm/keys
# Ziel der Datensicherung (Dienst "backup"), etwa eine NAS-Freigabe; muss fuer UID 1654 beschreibbar sein:
#   mkdir -p /srv/rmm/backup && chown 1654:1654 /srv/rmm/backup && chmod 700 /srv/rmm/backup
# Jede Instanz braucht ein eigenes Ziel. Wer das Ziel lesen kann, kann mit dem mitgesicherten Schluesselring Geheimnisse entschluesseln.
# RMM_BACKUP_PATH=/srv/rmm/backup

# --- Nur docker-compose.macvlan.yml ---
# RMM_IPV4_ADDRESS=192.168.10.50
# RMM_MACVLAN_NETWORK=MacVLAN

# --- Nur docker-compose.proxy.yml ---
# Name des vorhandenen Docker-Netzes, in dem der Reverse-Proxy laeuft (docker network ls)
# RMM_PROXY_NETWORK=proxy
